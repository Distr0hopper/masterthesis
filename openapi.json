{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/components": {
      "get": {
        "operationId": "ComponentsController_findAll",
        "parameters": [
          {
            "name": "domain",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "animal_behavior",
                "earth_observation"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ComponentListItemDto"
                  }
                }
              }
            }
          }
        },
        "summary": "List all components",
        "tags": [
          "components"
        ]
      },
      "post": {
        "operationId": "ComponentsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/CreateComponentDto"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "cwlFile": {
                        "type": "string",
                        "format": "binary"
                      },
                      "name": {
                        "type": "string"
                      },
                      "domain": {
                        "type": "string",
                        "enum": [
                          "animal_behavior",
                          "earth_observation"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentDetailDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Manually upload a CWL file as a new component (v1)",
        "tags": [
          "components"
        ]
      }
    },
    "/components/{id}": {
      "get": {
        "operationId": "ComponentsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Component ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Component not found"
          }
        },
        "summary": "Return component with ID",
        "tags": [
          "components"
        ]
      },
      "patch": {
        "operationId": "ComponentsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Component ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateComponentDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentDetailDto"
                }
              }
            }
          },
          "403": {
            "description": "Not the creator of this component"
          },
          "404": {
            "description": "Component not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update the description and/or domain of a component",
        "tags": [
          "components"
        ]
      },
      "delete": {
        "operationId": "ComponentsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Component ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Component successfully deleted"
          },
          "403": {
            "description": "Not the creator of this component"
          },
          "404": {
            "description": "Component not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete a component by ID",
        "tags": [
          "components"
        ]
      }
    },
    "/components/{id}/download": {
      "get": {
        "operationId": "ComponentsController_download",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Component ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CWL file download"
          },
          "404": {
            "description": "Component not found"
          }
        },
        "summary": "Download component as a .cwl file",
        "tags": [
          "components"
        ]
      }
    },
    "/components/{id}/bundle": {
      "get": {
        "operationId": "ComponentsController_bundle",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Component ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ZIP archive containing the CWL file and a pre-filled inputs template"
          },
          "404": {
            "description": "Component not found"
          }
        },
        "summary": "Download component bundle (.cwl + inputs.yaml) as a ZIP",
        "tags": [
          "components"
        ]
      }
    },
    "/components/{id}/versions": {
      "get": {
        "operationId": "ComponentsController_findVersions",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Any component ID within the lineage",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ComponentListItemDto"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Component not found"
          }
        },
        "summary": "List all versions of a component lineage",
        "tags": [
          "components"
        ]
      },
      "post": {
        "operationId": "ComponentsController_addManualVersion",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Parent component ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/AddVersionDto"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "cwlFile": {
                        "type": "string",
                        "format": "binary"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentDetailDto"
                }
              }
            }
          },
          "403": {
            "description": "Not the creator of this component"
          },
          "404": {
            "description": "Component not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Upload a new version of an existing component",
        "tags": [
          "components"
        ]
      }
    },
    "/components/package": {
      "post": {
        "operationId": "ComponentsController_package",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackageComponentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentDetailDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL or packaging failed"
          },
          "403": {
            "description": "Not the creator of this lineage (only applies when repoUrl already exists)"
          },
          "409": {
            "description": "This exact commit is already packaged"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Package a MoveApps app from a GitHub URL (creates v1 or new version if URL exists with a different commit)",
        "tags": [
          "components"
        ]
      }
    },
    "/components/{id}/versions/package": {
      "post": {
        "operationId": "ComponentsController_addPackagedVersion",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID of any version of the component",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentDetailDto"
                }
              }
            }
          },
          "400": {
            "description": "Component has no repoUrl or packaging failed"
          },
          "403": {
            "description": "Not the creator of this component"
          },
          "409": {
            "description": "This exact commit is already packaged"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Repackage a MoveApps component from its repo URL to create a new version",
        "tags": [
          "components"
        ]
      }
    },
    "/domains": {
      "get": {
        "operationId": "DomainsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "summary": "List all available component domains",
        "tags": [
          "domains"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered"
          }
        },
        "summary": "Register a new user",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        },
        "summary": "Login and receive JWT",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired token"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get current user profile",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Component Repository API",
    "description": "REST API for managing CWL-based workflow components",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateComponentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "My EO Component"
          },
          "domain": {
            "type": "string",
            "enum": [
              "animal_behavior",
              "earth_observation"
            ]
          },
          "authorName": {
            "type": "string",
            "example": "Julius Arzberger"
          },
          "repoUrl": {
            "type": "string",
            "example": "https://github.com/movestore/RemoveOutliers"
          },
          "repoCommitSha": {
            "type": "string",
            "example": "abc1234"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": null,
            "description": "Overrides the description extracted from the CWL file. Omit or set to null to use the extracted value."
          }
        },
        "required": [
          "name",
          "domain"
        ]
      },
      "AddVersionDto": {
        "type": "object",
        "properties": {
          "repoCommitSha": {
            "type": "string",
            "example": "abc1234"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ComponentListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "RemoveOutliers"
          },
          "authorName": {
            "type": "string",
            "nullable": true
          },
          "repoUrl": {
            "type": "string",
            "example": "https://github.com/movestore/RemoveOutliers"
          },
          "repoCommitSha": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "number"
          },
          "domain": {
            "type": "string",
            "enum": [
              "animal_behavior",
              "earth_observation"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "automated_packaging",
              "manual_upload"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "authorName",
          "repoCommitSha",
          "version",
          "source",
          "createdAt"
        ]
      },
      "ComponentCreatorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName"
        ]
      },
      "ParameterDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "maxspeed"
          },
          "cwlType": {
            "type": "string",
            "example": "double"
          },
          "defaultValue": {
            "type": "string",
            "nullable": true,
            "example": "20.0"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "direction": {
            "type": "string",
            "enum": [
              "input",
              "output"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "cwlType",
          "defaultValue",
          "description",
          "direction"
        ]
      },
      "ComponentDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "authorName": {
            "type": "string",
            "nullable": true
          },
          "createdBy": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ComponentCreatorDto"
              }
            ]
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "repoUrl": {
            "type": "string",
            "nullable": true
          },
          "repoCommitSha": {
            "type": "string",
            "nullable": true
          },
          "doi": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "number"
          },
          "cwlContent": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "enum": [
              "animal_behavior",
              "earth_observation"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "automated_packaging",
              "manual_upload"
            ]
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParameterDto"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "authorName",
          "createdBy",
          "description",
          "repoUrl",
          "repoCommitSha",
          "doi",
          "version",
          "cwlContent",
          "domain",
          "source",
          "parameters",
          "createdAt"
        ]
      },
      "PackageComponentDto": {
        "type": "object",
        "properties": {
          "repoUrl": {
            "type": "string",
            "example": "https://github.com/movestore/RemoveOutliers"
          },
          "domain": {
            "type": "string",
            "enum": [
              "animal_behavior",
              "earth_observation"
            ]
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": null,
            "description": "Overrides the description extracted from metadata.json. Omit or set to null to use the extracted value."
          }
        },
        "required": [
          "repoUrl",
          "domain"
        ]
      },
      "UpdateComponentDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "domain": {
            "type": "string",
            "enum": [
              "animal_behavior",
              "earth_observation"
            ]
          }
        }
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "firstName": {
            "type": "string",
            "example": "Jane"
          },
          "lastName": {
            "type": "string",
            "example": "Doe"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "firstName",
          "lastName",
          "password"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "createdAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "number",
            "example": 86400
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ]
      }
    }
  }
}