DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=moveapps
DATABASE_PASSWORD=moveapps
DATABASE_NAME=component_repository
PORT=3000

# Path to the installed moveapps-cwl-package console script
PACKAGING_EXECUTABLE=../automated-packaging/.venv/bin/moveapps-cwl-package
# Optional: GitHub PAT to avoid API rate limits (the CLI also reads GITHUB_TOKEN)
GITHUB_TOKEN=

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=86400

# Urls allowed to access the API (e.g. Frontend app running on localhost:3000)
CORS_ORIGIN=http://localhost:5173