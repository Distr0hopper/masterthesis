DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=moveapps
DATABASE_PASSWORD=moveapps
DATABASE_NAME=component_repository

PORT=8000

# "local" or "production" - controls whether failed startup migrations are fatal
ENVIRONMENT=local
# Run `alembic upgrade head` automatically on app startup
AUTO_MIGRATE=true

# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=
JWT_EXPIRES_IN=86400

# Urls allowed to access the API (e.g. Frontend app running on localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Path to the moveapps-cwl-package executable
PACKAGING_EXECUTABLE=../automated-packaging/.venv/bin/moveapps-cwl-package
# Optional: GitHub PAT to avoid API rate limits (the CLI also reads GITHUB_TOKEN)
GITHUB_TOKEN=

# "smtp" (Mailhog, local dev) or "resend" (production)
EMAIL_PROVIDER=smtp

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@localhost

# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# One-time login code behavior (in seconds)
OTP_EXPIRES_IN=600
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN=60